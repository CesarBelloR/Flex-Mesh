menuconfig ADC_MODULES
	bool "Configure for ADC module"
	depends on ADC
	help
	  Enable ADC Modules 

if ADC_MODULES

config ADC_MODULES_FILTER_SAMPLE_COUNT
	int "Number of samples that are taken when using adc_get_channel_filtered()"
	default 9

module = ADC_MODULES
module-str = ADC Modules
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

endif # ADC_MODULES
