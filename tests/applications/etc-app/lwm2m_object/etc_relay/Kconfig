# The relay object source references these sizes, which are normally provided
# under LWM2M_INTEGRATION. Define them here so the object compiles standalone.
config LWM2M_ETC_RELAY_OBJ_DATA_SIZE
	int
	default 512

config LWM2M_ETC_RELAY_OBJ_COMMAND_SIZE
	int
	default 128

source "Kconfig.zephyr"
