From 740b00e535061abf4a2be60e0470a6e666026ccf Mon Sep 17 00:00:00 2001
From: Kien Bui <kien.bui@exacttechnology.com>
Date: Tue, 12 Dec 2023 14:54:45 +0700
Subject: [PATCH] LwM2M: Add API to export SenML buffer output

---
 subsys/net/lib/lwm2m/lwm2m_message_handling.c | 143 ++++++++++++++++++
 subsys/net/lib/lwm2m/lwm2m_message_handling.h |   2 +
 subsys/net/lib/lwm2m/lwm2m_rw_senml_cbor.c    |  14 +-
 subsys/net/lib/lwm2m/lwm2m_rw_senml_cbor.h    |   2 +-
 4 files changed, 158 insertions(+), 3 deletions(-)

diff --git a/subsys/net/lib/lwm2m/lwm2m_message_handling.c b/subsys/net/lib/lwm2m/lwm2m_message_handling.c
index 3c872599cb..7e16f2338b 100644
--- a/subsys/net/lib/lwm2m/lwm2m_message_handling.c
+++ b/subsys/net/lib/lwm2m/lwm2m_message_handling.c
@@ -2695,7 +2695,58 @@ int lwm2m_perform_composite_read_op(struct lwm2m_message *msg, uint16_t content_
 
 	/* Add object start mark */
 	engine_put_begin(&msg->out, &msg->path);
+	/* Read resource from path */
+	SYS_SLIST_FOR_EACH_CONTAINER(lwm2m_path_list, entry, node) {
+		/* Copy path to message path */
+		memcpy(&msg->path, &entry->path, sizeof(struct lwm2m_obj_path));
+
+		if (msg->path.level >= LWM2M_PATH_LEVEL_OBJECT_INST) {
+			obj_inst = get_engine_obj_inst(msg->path.obj_id, msg->path.obj_inst_id);
+		} else if (msg->path.level == LWM2M_PATH_LEVEL_OBJECT) {
+			/* find first obj_inst with path's obj_id */
+			obj_inst = next_engine_obj_inst(msg->path.obj_id, -1);
+		} else {
+			/* Read root Path */
+			ret = lwm2m_perform_composite_read_root(msg, &num_read);
+			if (ret == -ENOMEM) {
+				LOG_ERR("Supported message size is too small for read root");
+				return ret;
+			}
+			break;
+		}
+
+		if (!obj_inst) {
+			continue;
+		}
+
+		ret = lwm2m_perform_read_object_instance(msg, obj_inst, &num_read);
+		if (ret == -ENOMEM) {
+			return ret;
+		}
+	}
+	/* did not read anything even if we should have - on single item */
+	if (num_read == 0U) {
+		return -ENOENT;
+	}
 
+	/* Add object end mark */
+	if (engine_put_end(&msg->out, &msg->path) < 0) {
+		return -ENOMEM;
+	}
+
+	return 0;
+}
+
+int lwm2m_export_composite_read_op(struct lwm2m_message *msg, uint16_t content_format,
+				    sys_slist_t *lwm2m_path_list) 
+{
+	struct lwm2m_engine_obj_inst *obj_inst = NULL;
+	struct lwm2m_obj_path_list *entry;
+	int ret = 0;
+	uint8_t num_read = 0U;
+
+	/* Add object start mark */
+	engine_put_begin(&msg->out, &msg->path);
 	/* Read resource from path */
 	SYS_SLIST_FOR_EACH_CONTAINER(lwm2m_path_list, entry, node) {
 		/* Copy path to message path */
@@ -3068,10 +3119,13 @@ msg_init:
 		LOG_ERR("Send (err:%d)", ret);
 		goto cleanup;
 	}
+	
 #if defined(CONFIG_LWM2M_RESOURCE_DATA_CACHE_SUPPORT)
 	msg->cache_info = NULL;
 #endif
 	LOG_INF("Send op to server (/dp)");
+	LOG_HEXDUMP_INF(msg->out.out_cpkt->data, msg->out.out_cpkt->offset, "SEND");
+	k_sleep(K_SECONDS(1));
 	lwm2m_information_interface_send(msg);
 
 #if defined(CONFIG_LWM2M_RESOURCE_DATA_CACHE_SUPPORT)
@@ -3129,3 +3183,92 @@ int lwm2m_engine_send(struct lwm2m_ctx *ctx, char const *path_list[], uint8_t pa
 
 	return lwm2m_send_cb(ctx, lwm2m_path_list, path_list_size, NULL);
 }
+
+
+int lwm2m_engine_export_data(const struct lwm2m_obj_path path_list[], uint8_t path_list_size,
+	uint8_t* out_buf, int* out_len)
+{
+#if defined(CONFIG_LWM2M_SERVER_OBJECT_VERSION_1_1)
+	struct lwm2m_message *msg = (struct lwm2m_message*)k_malloc(sizeof(struct lwm2m_message));
+	int ret;
+
+	__ASSERT_NO_MSG(out_buf != NULL);
+
+	/* Path list buffer */
+	struct lwm2m_obj_path_list lwm2m_path_list_buf[CONFIG_LWM2M_COMPOSITE_PATH_LIST_SIZE];
+	sys_slist_t lwm2m_path_list;
+	sys_slist_t lwm2m_path_free_list;
+#if defined(CONFIG_LWM2M_RESOURCE_DATA_CACHE_SUPPORT)
+	struct lwm2m_cache_read_info cache_temp_info;
+
+	cache_temp_info.entry_size = 0;
+	cache_temp_info.entry_limit = 0;
+#endif
+	/* Init list */
+	lwm2m_engine_path_list_init(&lwm2m_path_list, &lwm2m_path_free_list, lwm2m_path_list_buf,
+				    CONFIG_LWM2M_COMPOSITE_PATH_LIST_SIZE);
+
+	if (path_list_size > CONFIG_LWM2M_COMPOSITE_PATH_LIST_SIZE) {
+		if (msg) {
+			k_free(msg);
+		}
+		return -E2BIG;
+	}
+
+	/* Parse Path to internal used object path format */
+	for (int i = 0; i < path_list_size; i++) {
+		/* Add to linked list */
+		if (lwm2m_engine_add_path_to_list(&lwm2m_path_list, &lwm2m_path_free_list,
+						  &path_list[i])) {
+			if (msg) {
+				k_free(msg);
+			}
+			return -1;
+		}
+	}
+	/* Clear path which are part are part of recursive path /1 will include /1/0/1 */
+	lwm2m_engine_clear_duplicate_path(&lwm2m_path_list, &lwm2m_path_free_list);
+	lwm2m_registry_lock();
+
+	msg->cpkt.offset = 0;
+	msg->cpkt.data = msg->msg_data;
+	msg->cpkt.max_len = sizeof(msg->msg_data);
+	msg->out.out_cpkt = &msg->cpkt;
+
+	ret = select_writer(&msg->out, LWM2M_FORMAT_APP_SENML_CBOR);
+	if (ret) {
+		goto cleanup;
+	}
+
+	/* Write requested path data */
+	ret = do_export_op_senml_cbor(msg, &lwm2m_path_list);
+	if (ret < 0) {
+		LOG_ERR("Send (err:%d)", ret);
+		goto cleanup;
+	}
+	
+	if (*out_len < msg->out.out_cpkt->offset) {
+		LOG_ERR("No memory");
+		ret = -ENOMEM;
+	} else {
+		memcpy(out_buf, msg->out.out_cpkt->data, msg->out.out_cpkt->offset);
+		*out_len = msg->out.out_cpkt->offset;
+		ret = 0;
+	}
+	
+	lwm2m_registry_unlock();
+	if (msg) {
+		k_free(msg);
+	}
+	return ret;
+cleanup:
+	if (msg) {
+		k_free(msg);
+	}
+	lwm2m_registry_unlock();
+	return ret;
+#else
+	LOG_WRN("LwM2M send is only supported for CONFIG_LWM2M_SERVER_OBJECT_VERSION_1_1");
+	return -ENOTSUP;
+#endif
+}
\ No newline at end of file
diff --git a/subsys/net/lib/lwm2m/lwm2m_message_handling.h b/subsys/net/lib/lwm2m/lwm2m_message_handling.h
index 99bad786f4..3c740d684a 100644
--- a/subsys/net/lib/lwm2m/lwm2m_message_handling.h
+++ b/subsys/net/lib/lwm2m/lwm2m_message_handling.h
@@ -60,6 +60,8 @@ int lwm2m_perform_read_op(struct lwm2m_message *msg, uint16_t content_format);
 
 int lwm2m_perform_composite_read_op(struct lwm2m_message *msg, uint16_t content_format,
 				    sys_slist_t *lwm2m_path_list);
+int lwm2m_export_composite_read_op(struct lwm2m_message *msg, uint16_t content_format,
+				    sys_slist_t *lwm2m_path_list);
 
 int do_composite_read_op_for_parsed_list(struct lwm2m_message *msg, uint16_t content_format,
 					 sys_slist_t *path_list);
diff --git a/subsys/net/lib/lwm2m/lwm2m_rw_senml_cbor.c b/subsys/net/lib/lwm2m/lwm2m_rw_senml_cbor.c
index 45c1da49c0..26ee5c3029 100644
--- a/subsys/net/lib/lwm2m/lwm2m_rw_senml_cbor.c
+++ b/subsys/net/lib/lwm2m/lwm2m_rw_senml_cbor.c
@@ -181,7 +181,6 @@ static int put_empty_array(struct lwm2m_output_context *out)
 
 	memset(CPKT_BUF_W_PTR(out->out_cpkt), 0x80, len); /* 80 # array(0) */
 	out->out_cpkt->offset += len;
-
 	return len;
 }
 
@@ -195,7 +194,6 @@ static int put_end(struct lwm2m_output_context *out, struct lwm2m_obj_path *path
 
 		return len;
 	}
-
 	uint_fast8_t ret =
 		cbor_encode_lwm2m_senml(CPKT_BUF_W_REGION(out->out_cpkt), input, &len);
 
@@ -1059,6 +1057,18 @@ int do_send_op_senml_cbor(struct lwm2m_message *msg, sys_slist_t *lwm2m_path_lis
 	return ret;
 }
 
+int do_export_op_senml_cbor(struct lwm2m_message *msg, sys_slist_t *lwm2m_path_list) {
+	int ret;
+
+	setup_out_fmt_data(msg);
+
+	ret = lwm2m_export_composite_read_op(msg, LWM2M_FORMAT_APP_SENML_CBOR, lwm2m_path_list);
+
+	clear_out_fmt_data(msg);
+
+	return ret;
+}
+
 static int path_to_string(char *buf, size_t buf_size, const struct lwm2m_obj_path *input,
 			 int level_max)
 {
diff --git a/subsys/net/lib/lwm2m/lwm2m_rw_senml_cbor.h b/subsys/net/lib/lwm2m/lwm2m_rw_senml_cbor.h
index 707436e5e7..489c2f88f2 100644
--- a/subsys/net/lib/lwm2m/lwm2m_rw_senml_cbor.h
+++ b/subsys/net/lib/lwm2m/lwm2m_rw_senml_cbor.h
@@ -23,5 +23,5 @@ int do_composite_observe_parse_path_senml_cbor(struct lwm2m_message *msg,
 					       sys_slist_t *lwm2m_path_free_list);
 
 int do_send_op_senml_cbor(struct lwm2m_message *msg, sys_slist_t *lwm2m_path_list);
-
+int do_export_op_senml_cbor(struct lwm2m_message *msg, sys_slist_t *lwm2m_path_list);
 #endif /* LWM2M_RW_SENML_CBOR_H_ */
