  *
- * Generated using zcbor version 0.8.1
+ * Generated using zcbor version 0.8.99
  * https://github.com/zephyrproject-rtos/zcbor
  * Generated with a --default-max-qty of 99
  */
@@ -17,7 +17,7 @@
 #include "zcbor_print.h"
 
 static bool decode_repeated_record_bn(zcbor_state_t *state, struct record_bn *result);
-static bool decode_repeated_record_bt(zcbor_state_t *state, struct record_bt *result);
+static bool decode_repeated_record_bt(zcbor_state_t *state, struct record_bt_r *result);
 static bool decode_repeated_record_n(zcbor_state_t *state, struct record_n *result);
 static bool decode_repeated_record_t(zcbor_state_t *state, struct record_t *result);
 static bool decode_repeated_record_union(zcbor_state_t *state, struct record_union_r *result);
@@ -45,15 +45,22 @@ static bool decode_repeated_record_bn(zcbor_state_t *state, struct record_bn *re
 	return tmp_result;
 }
 
-static bool decode_repeated_record_bt(zcbor_state_t *state, struct record_bt *result)
+static bool decode_repeated_record_bt(zcbor_state_t *state, struct record_bt_r *result)
 {
 	zcbor_log("%s\r\n", __func__);
+	bool int_res;
 
 	bool tmp_result =
 		((((zcbor_int32_expect(state, (-3)))) &&
-		  (zcbor_int64_decode(state, (&(*result).record_bt))) &&
-		  ((((*result).record_bt >= INT64_MIN) && ((*result).record_bt <= INT64_MAX)) ||
-		   (zcbor_error(state, ZCBOR_ERR_WRONG_RANGE), false))));
+		  (zcbor_union_start_code(state) &&
+		   (int_res = ((((zcbor_int64_decode(state, (&(*result).record_bt_int))) &&
+				 ((((*result).record_bt_int >= INT64_MIN) &&
+				   ((*result).record_bt_int <= INT64_MAX)) ||
+				  (zcbor_error(state, ZCBOR_ERR_WRONG_RANGE), false))) &&
+				(((*result).record_bt_choice = record_bt_int_c), true)) ||
+			       (((zcbor_float_decode(state, (&(*result).record_bt_float)))) &&
+				(((*result).record_bt_choice = record_bt_float_c), true))),
+		    zcbor_union_end_code(state), int_res))));
 
 	if (!tmp_result) {
 		zcbor_trace_file(state);
diff --git a/subsys/net/lib/lwm2m/lwm2m_senml_cbor_decode.h b/subsys/net/lib/lwm2m/lwm2m_senml_cbor_decode.h
index 4e1fdeb66a2..f987e805a5f 100644
--- a/subsys/net/lib/lwm2m/lwm2m_senml_cbor_decode.h
+++ b/subsys/net/lib/lwm2m/lwm2m_senml_cbor_decode.h
@@ -3,7 +3,7 @@
  *
  * SPDX-License-Identifier: Apache-2.0
  *
- * Generated using zcbor version 0.8.1
+ * Generated using zcbor version 0.8.99
  * https://github.com/zephyrproject-rtos/zcbor
  * Generated with a --default-max-qty of 99
  */
diff --git a/subsys/net/lib/lwm2m/lwm2m_senml_cbor_encode.c b/subsys/net/lib/lwm2m/lwm2m_senml_cbor_encode.c
