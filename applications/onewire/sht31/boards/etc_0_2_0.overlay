&i2c0 {
	w1: w1@18 {
		compatible = "maxim,ds2484";
		reg = <0x18>;

		ds28e18 {
			compatible = "maxim,ds28e18";
			family-code = <0x56>;
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			sht3xd@44 {
				compatible = "sensirion,sht3xd";
				reg = <0x44>;
				status = "okay";
			};
		};
	};
};
