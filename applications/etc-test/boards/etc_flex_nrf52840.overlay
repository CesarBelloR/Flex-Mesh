/ {
	chosen {
		nordic,pm-ext-flash = &mx25r1635;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,console = &cdc_acm_uart0;
	};

	board-control {
		modem_uart_oe: modem-uart-oe {
			compatible = "etc,output";
			control-gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
			status = "okay";
		};
	};

	aliases {
		rtc = &i2c0;
	};
};

&w1 {
	w1_tmp1826: w1_tmp1826 {
		compatible = "ti,tmp1826";
		family-code = <0x26>;
		resolution = <12>;
		status = "okay";
	};
	
	w1_ds28e18: w1_ds28e18 {
		compatible = "maxim,ds28e18";
		family-code = <0x56>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		sht31@44 {
			compatible = "sensirion,sht31";
			reg = <0x44>;
			status = "okay";
		};
	};
};

zephyr_udc0: &usbd {
	cdc_acm_uart1 {
		status = "disabled";
	};
};