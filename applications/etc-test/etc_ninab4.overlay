/ {
	chosen {
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "CDC_ACM_0";
	};
};

/* A0 = P0.04 = AIN2 */
/* A1 = P0.30 = AIN6 */
/* A2 = P0.5  = AIN3 */
/* A3 = P0.2  = AIN0 */
/* A4 = P0.28 = AIN4 */
/ {
	zephyr,user {
		/* adjust channel number according to pinmux in board.dts */
		io-channels = <&adc 2>, <&adc 6>, <&adc 3>, <&adc 0>, <&adc 4>;
	};
};
