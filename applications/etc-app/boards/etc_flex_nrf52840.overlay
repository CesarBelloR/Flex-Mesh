/ {
	chosen {
		nordic,pm-ext-flash = &mx25r1635;
		zephyr,uart-mcumgr = &cdc_acm_uart1;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,console = &cdc_acm_uart0;
	};

	aliases {
		rtc = &i2c0;
	};
};

/ {
	sram@2003F000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2003F000 0xC00>;
		zephyr,memory-region = "RetainedMem";
		status = "okay";

		retainedmem0: retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
	        };
        };

	sram@2003FC00 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2003FC00 0x380>;
		zephyr,memory-region = "ReclaimRetainedMem";
		status = "okay";

		retainedmem1: retainedmem1 {
			compatible = "zephyr,retained-ram";
			status = "okay";
		};
	};

	sram@2003FF80 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2003FF80 0x80>;
		zephyr,memory-region = "LteSyncRetainedMem";
		status = "okay";

		retainedmem2: retainedmem2 {
			compatible = "zephyr,retained-ram";
			status = "okay";
		};
	};

	aliases {
		reclaim-request-ram = &retainedmem1;
		record-header-ram = &retainedmem0;
		lte-sync-ram = &retainedmem2;
	};
};

&gpregret1 {
	status = "disabled";
};

&gpregret2 {
	status = "disabled";
};

&sram0 {
	reg = <0x20000000 DT_SIZE_K(252)>;
};

// Comment deletion of wp-gpios and hold-gpios after upgrade to NCS v2.7.0
// Without these properties, the spi_nor driver doesn't initialize properly.
&spi3 {
	mx25r1635: mx25r1635@0 {
		spi-max-frequency = <32000000>;
		// /delete-property/ wp-gpios;
		// /delete-property/ hold-gpios;
	};
};

