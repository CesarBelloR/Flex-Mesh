
&i2c1 {
	w1: w1@18 {
		compatible = "exact,ds2484";
		reg = <0x18>;
		w1_ds28e18: w1_ds28e18 {
			compatible = "maxim,ds28e18";
			family-code = <0x56>;
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			sht31@44 {
				compatible = "sensirion,sht31";
				reg = <0x44>;
				status = "okay";
			};
		};
		w1_tmp1826: w1_tmp1826 {
			compatible = "ti,tmp1826";
			family-code = <0x26>;
			resolution = <12>;
			status = "okay";
		};
	};
};