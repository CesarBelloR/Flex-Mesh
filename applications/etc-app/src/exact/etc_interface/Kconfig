menuconfig ETC_INTERFACE
	bool "HALL sensor or User button interface"
	select GPIO
	default y
	
if ETC_INTERFACE

config ETC_INTERFACE_TEST_SHELL
	bool "ETC interface test shell commands"
	depends on SHELL
	help
	  Adds shell commands to inject interface events (e.g. a HALL/magnet
	  swipe) for hardware-in-the-loop testing. Test/diagnostic use only.

module = ETC_INTERFACE
module-str = etc interface
source "subsys/logging/Kconfig.template.log_config"

endif # ETC_INTERFACE
