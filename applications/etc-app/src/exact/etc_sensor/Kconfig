menuconfig ETC_SENSOR
	bool "Ambient temperature sensor"
	default y
	help
	  The ambient temperature sensor library for application

if ETC_SENSOR

choice
	prompt "Select protocol to get ambient sensor"
	default ETC_AMBIENT_NTC_SENSOR

config ETC_AMBIENT_NTC_SENSOR
	bool "Select ambient with NTC sensor"
	depends on !TMP1075

config ETC_AMBIENT_I2C_SENSOR
	bool "Select ambient with I2C sensor"
	depends on TMP1075

endchoice

config ETC_SENSOR_TMP1826_GPIO_RETRIES
	int "Number of retries to set GPIO for TMP1826"
	default 3
	help
	  Number of retries to set GPIO for TMP1826.

config ETC_SENSOR_SIM_SHELL
	bool "Simulated sensor reading shell commands"
	depends on SHELL
	help
	  Adds shell commands (sensor_sim set/clear/status) that substitute
	  simulated readings into the sample before the sensor event is
	  submitted, so hardware-in-the-loop tests can drive a reading without
	  moving a physical probe. Test/diagnostic use only.

config ETC_SENSOR_HW_LOCK_TIMEOUT_S
	int "Timeout acquiring the analog front-end lock, in seconds"
	default 15
	help
	  How long etc_sensor_run_acquisition() waits for the front-end lock before
	  skipping the sample and returning -EBUSY. Must exceed the longest normal
	  calibration run, otherwise samples are dropped whenever a calibration
	  happens to overlap. Waiting forever here allowed a stuck acquisition to
	  park the sensor thread indefinitely.

module = ETC_SENSOR
module-str = etc sensor
source "subsys/logging/Kconfig.template.log_config"

endif # ETC_SENSOR
