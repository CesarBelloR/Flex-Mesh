CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52833_QIAA=y
CONFIG_BOARD_ETC=y

# Enable hardware stack protection
CONFIG_HW_STACK_PROTECTION=y

# Enable MPU
CONFIG_ARM_MPU=y

# enable console
CONFIG_CONSOLE=y

# additional board options
CONFIG_GPIO_AS_PINRESET=n

# Enable UART Console
CONFIG_UART_CONSOLE=y

# Enable RTT
CONFIG_USE_SEGGER_RTT=y

# Enable PinCTRL
CONFIG_PINCTRL=y

# NFC Pins is used as a gpio
CONFIG_NFCT_PINS_AS_GPIOS=y

CONFIG_SERIAL=y
CONFIG_GPIO=y

# Increase priority of I2C for battery workaround
CONFIG_I2C=y
CONFIG_I2C_INIT_PRIORITY=45

# Flash operation
CONFIG_SPI=y
CONFIG_SPI_NOR_FLASH_LAYOUT_PAGE_SIZE=4096
CONFIG_SPI_NOR=y
CONFIG_FLASH=y